      "args": [
        "--directory", "mcp/servers/terminal_server",
        "run",
        "terminal_server.py"
      ]
    },
    "arithmetic_server": {
      "command": "streamable_http",
      "args": [
        "http://localhost:3000/mcp/"
      ]
    }
  }
}